db.products.aggregate([
    {
        $match: {
            price: { $gt: 10000 }
        }
    }
]);

db.products.aggregate([
    {
        $project: {
            _id: 0,
            productId: 1,
            productName: 1,
            category: 1,
            brand: 1,
            price: 1
        }
    }
]);

db.products.aggregate([
    {
        $project: {
            _id: 0,
            productId: 1,
            productName: 1,
            price: 1,
            stock: 1,
            inventoryValue: {
                $multiply: ["$price", "$stock"]
            }
        }
    }
]);

db.products.aggregate([
    {
        $group: {
            _id: "$category",
            totalProducts: { $sum: 1 },
            totalStock: { $sum: "$stock" },
            averagePrice: { $avg: "$price" }
        }
    }
]);

db.products.aggregate([
    {
        $group: {
            _id: "$brand",
            totalProducts: { $sum: 1 },
            totalStock: { $sum: "$stock" },
            averagePrice: { $avg: "$price" },
            highestPrice: { $max: "$price" },
            lowestPrice: { $min: "$price" }
        }
    }
]);

db.products.aggregate([
    {
        $sort: {
            price: -1
        }
    },
    {
        $limit: 5
    },
    {
        $project: {
            _id: 0,
            productId: 1,
            productName: 1,
            category: 1,
            brand: 1,
            price: 1
        }
    }
]);

db.products.aggregate([
    {
        $sort: {
            rating: -1
        }
    },
    {
        $limit: 10
    },
    {
        $project: {
            _id: 0,
            productId: 1,
            productName: 1,
            category: 1,
            brand: 1,
            rating: 1,
            price: 1
        }
    }
]);

db.products.aggregate([
    {
        $group: {
            _id: "$category",
            averageRating: { $avg: "$rating" },
            totalProducts: { $sum: 1 }
        }
    },
    {
        $sort: {
            averageRating: -1
        }
    }
]);

db.products.aggregate([
    {
        $match: {
            stock: { $gt: 0 }
        }
    },
    {
        $project: {
            _id: 0,
            productId: 1,
            productName: 1,
            category: 1,
            brand: 1,
            stock: 1,
            inStockStatus: {
                $gt: ["$stock", 0]
            }
        }
    }
]);

db.products.aggregate([
    {
        $group: {
            _id: "$category",
            totalProducts: { $sum: 1 }
        }
    },
    {
        $sort: {
            totalProducts: -1
        }
    }
]);

db.products.aggregate([
    {
        $group: {
            _id: "$category",
            totalInventoryValue: {
                $sum: {
                    $multiply: ["$price", "$stock"]
                }
            }
        }
    },
    {
        $sort: {
            totalInventoryValue: -1
        }
    }
]);

db.products.aggregate([
    {
        $group: {
            _id: "$brand",
            totalProducts: { $sum: 1 },
            totalStock: { $sum: "$stock" },
            averagePrice: { $avg: "$price" },
            totalInventoryValue: {
                $sum: {
                    $multiply: ["$price", "$stock"]
                }
            }
        }
    },
    {
        $sort: {
            totalInventoryValue: -1
        }
    }
]);

db.products.aggregate([
    {
        $match: {
            stock: { $gt: 0 }
        }
    },
    {
        $group: {
            _id: "$category",
            totalProducts: { $sum: 1 },
            totalStock: { $sum: "$stock" },
            averagePrice: { $avg: "$price" },
            averageRating: { $avg: "$rating" },
            totalInventoryValue: {
                $sum: {
                    $multiply: ["$price", "$stock"]
                }
            }
        }
    },
    {
        $sort: {
            totalInventoryValue: -1
        }
    },
    {
        $project: {
            _id: 0,
            category: "$_id",
            totalProducts: 1,
            totalStock: 1,
            averagePrice: {
                $round: ["$averagePrice", 2]
            },
            averageRating: {
                $round: ["$averageRating", 2]
            },
            totalInventoryValue: 1
        }
    }
]);
